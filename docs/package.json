{
  "name": "drop",
  "version": "4.0.0",
  "type": "module",
  "description": "Daily domain tracker PWA - Sleep, Fitness, Mind, Spirit",
  "private": true,
  "scripts": {
    "test": "npm run test:dom",
    "test:dom": "echo 'Open docs/testing/pages/index.html in a browser to run DOM tests'",
    "test:visual": "playwright test --config docs/testing/playwright.config.js",
    "test:visual:update": "playwright test --config docs/testing/playwright.config.js --update-snapshots",
    "test:visual:ui": "playwright test --config docs/testing/playwright.config.js --ui",
    "serve": "npx serve . -p 3000",
    "dev": "npx serve . -p 3000 -s",
    "version:sync": "node update-version.js",
    "lint": "eslint . --ext .js,.mjs",
    "lint:fix": "eslint . --ext .js,.mjs --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run lint && npm run format:check && npm run test",
    "precommit": "npm run lint && npm run format:check"
  },
  "keywords": [
    "pwa",
    "wellness",
    "tracker",
    "productivity"
  ],
  "author": "Benjamin Haddon",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BenWassa/drop.git"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
